{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "./src",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"]
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/canvas-core" },
    { "path": "../../packages/canvas-pixi" },
    { "path": "../../packages/preferences" },
    { "path": "../../packages/edit-history" },
    { "path": "../../packages/factory-core" },
    { "path": "../../packages/game-data" }
  ]
}
