{
  "name": "satisfactory-belt",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @satisfactory-belt/web dev",
    "dev:https": "pnpm --filter @satisfactory-belt/web dev:https",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0"
}
