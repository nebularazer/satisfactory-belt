{
  "name": "satisfactory-belt",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm check:assets && pnpm typecheck && pnpm test && pnpm build",
    "check:assets": "node scripts/verify-web-assets.mjs",
    "dev": "pnpm --filter @satisfactory-belt/web dev",
    "dev:https": "pnpm --filter @satisfactory-belt/web dev:https",
    "extract:production": "node scripts/extract-production-data.mjs",
    "generate:assets": "node scripts/generate-web-assets.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "test": "pnpm --recursive --if-present test",
    "test:e2e": "pnpm --filter @satisfactory-belt/web test:e2e",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0"
}
