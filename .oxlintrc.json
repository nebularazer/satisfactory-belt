{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["dist/**", ".assets/**"],
  "options": {
    "typeAware": true
  },
  "plugins": ["oxc", "typescript", "unicorn", "react", "react-perf", "jsx-a11y"],
  "rules": {
    "react/react-in-jsx-scope": "off"
  }
}
